# ---------------------------------------------------------------------------
# FinalBid.vin scraper configuration
# run_scraper.py reads this automatically.
# Real environment variables override anything set here.
# ---------------------------------------------------------------------------

# --- Postgres ---------------------------------------------------------------
# Standard libpq connection string. Point it at any Postgres server — native
# install, container published on a port, or a hosted instance. run_scraper.py
# connects to this directly with psycopg; Docker is not required.
#   DSN=postgresql://user:password@host:port/database
DSN=postgresql://auction:auction@localhost:5433/finalbid
# Seconds to keep retrying a not-yet-listening Postgres before giving up
# (0 = fail fast). Handy when the DB service is still booting.
DB_WAIT=0

# --- What to scrape --------------------------------------------------------
# Leave SCRAPE_* empty to scrape the whole archive.
SCRAPE_Q=
SCRAPE_MAKE=
SCRAPE_MODEL=
SCRAPE_TITLE=
SCRAPE_DAMAGE=
SCRAPE_SOURCE=
SCRAPE_VIN=
SCRAPE_PRICE_MIN=
SCRAPE_PRICE_MAX=
# NOTE: finalbid.vin has no JSON API, so filter flags are not wired up yet.
# Leave everything empty to crawl the entire archive.

# --- How to scrape ---------------------------------------------------------
# WORKERS      = listing pages prefetched in parallel (cheap, 1 request each).
# CONCURRENCY  = parallel detail requests sharing one keep-alive pool. This is
#                what drives throughput (~12 req/s vs ~1.5 with urllib threads);
#                raise carefully, the site starts throttling above ~16-20.
# SPACING      = minimum gap between request starts across the whole run.
WORKERS=5
CONCURRENCY=12
PER_PAGE=100
SPACING=0.05
RETRIES=5
TIMEOUT=45
LIMIT=0

# --- Run mode --------------------------------------------------------------
# Default (both 0) = resume: top-up newest pages, then continue the deep crawl
# from (last page - OVERLAP) to the end of the archive.
# FRESH=1  -> scan from page 1 and stop at the first repeated page (new arrivals).
# FULL=1   -> walk page 1 to the end, ignoring the checkpoint (keeps existing data).
FRESH=0
FULL=0

# --- Resume behaviour ------------------------------------------------------
# Start the archive walk at this page instead of page 1 / the resume checkpoint.
# Set it to jump straight to a specific page (overrides FRESH/FULL/resume).
# 0 = off (use the normal plan).
START_PAGE=0
# Pages to re-scan before a detected coverage gap / from the last page.
OVERLAP=15
# Stop a top-up / fresh pass after this many consecutive repeated pages.
STOP_AFTER=2
# Abort the whole walk after this many consecutive failed listing pages
# (site down / blocking us) instead of looping forever.
MAX_ERROR_STREAK=5
# Rebuild bid_history every N minutes during a run (plus once at the end).
BID_HISTORY_MINUTES=5

# --- Timing / logging ------------------------------------------------------
# Flag any single request slower than this many seconds (SLOW ... log line).
SLOW_SECONDS=3
# Print a rolling throughput line every N pages (0 disables).
RATE_EVERY=10
# Extra concurrent passes for lots whose detail fetch failed (transient blips).
# Anything still failing keeps detailed=false and is retried on the next run;
# its attempt count + last error are stored in lots.detail_attempts/detail_error.
DETAIL_RETRY_PASSES=1

# --- Backfill --------------------------------------------------------------
# Re-fetch the lot page of every row whose detail is missing, straight from the
# DB (no archive walk). Use after a parser change to fill the existing rows:
#   UPDATE lots SET detailed = false;      -- queue everything
#   python run_scraper.py --re-detail
# Resumable: rows are marked detailed as they succeed; interrupt any time.
RE_DETAIL=0
RE_DETAIL_BATCH=250

# --- Where to put it -------------------------------------------------------
# Set DETAIL=1 to fetch each lot page for photos / engine / fuel.
# Slower (~1 extra request per lot) but gives much richer rows.
DETAIL=1
LOAD_DB=1
TRACK_PAGES=1
REFRESH_BID_HISTORY=1
# Optional JSONL mirror; leave empty for DB-only (no file is written).
OUT=

# --- Sharding --------------------------------------------------------------
# Comma-separated makes to scrape one after another (each run resumes its own
# pages via scrape_pages). Example: MAKES=TOYOTA,FORD,HONDA
# Leave empty to scrape everything in a single pass.
MAKES=

# READONLY_USERNAME_AND_PASSWORD=auction_readonly